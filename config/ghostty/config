# Theme — auto-switches with macOS appearance
theme = dark:GitHub Dark High Contrast,light:GitHub Light High Contrast

# Font — JetBrainsMono NF, italic everywhere
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 15
font-style = Italic
font-style-bold = Bold Italic
font-style-italic = Italic
font-style-bold-italic = Bold Italic

# Terminal settings  
term = xterm-256color

# Window settings
window-decoration = true
# Glass: translucent + blurred backdrop (macOS native blur)
background-opacity = 0.82
background-blur = 20
keybind = shift+enter=text:\n
keybind = super+left=goto_split:left
keybind = super+right=goto_split:right
keybind = super+up=goto_split:up
keybind = super+down=goto_split:down

# Chrome — herdr owns tabs/panes, so Ghostty renders none
macos-titlebar-style = hidden
window-show-tab-bar = never
