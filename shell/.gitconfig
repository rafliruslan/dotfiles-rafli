[user]
  name = rafliruslan
  email = rafliruslan@users.noreply.github.com

[includeIf "gitdir:~/personal/"]
  path = ~/.gitconfig-personal

[core]
  sshCommand = ssh

[init]
  defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Machine-local overrides (real email, work identities). Never committed.
[include]
  path = ~/.gitconfig.local
