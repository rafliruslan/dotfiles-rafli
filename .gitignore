# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Neovim
config/nvim/lazy-lock.json
config/nvim/.luarc.json
config/nvim/after/queries/

# tmux plugins (managed by TPM)
config/tmux/plugins/*/

# Shell history and cache
.zsh_history
.bash_history
.zcompdump*

# Configs with sensitive/auth data
config/gh/
config/git/*
config/composer/

# TheFuck cache
config/thefuck/__pycache__/

# Raycast: all of it. config.json carries auth tokens and the filename
# gives no hint, which is how two of them stayed public for five months.
config/raycast/

# Backup files
*.backup
*.backup.*
*~

# Log files
*.log

# Temporary files
*.tmp
*.temp
.swp
.swo

# Local environment files
.env
.env.local

# SketchyBar compiled helpers (if any)
config/sketchybar/helpers/*
!config/sketchybar/helpers/.gitkeep

# Personal sensitive data
*password*
*secret*
*key*
*token*
*credential*

# System-specific files that shouldn't be shared
*.local
*.private

# Lock files
*.lock

# Plan document
DOTFILES_PLAN.md

# Work identity - this repo is public
shell/.gitconfig-a1c

# Installed Claude skills are third-party and re-installable, like node_modules
claude/skills/

# Claude state: credentials, transcripts, caches. Only config is tracked.
claude/.credentials.json
claude/projects/
claude/sessions/
claude/history.jsonl

# Exceptions: these match the broad name rules above but hold no secrets.
# The scanner itself trips "*secret*", which is a fair illustration of why
# name-based rules are the wrong tool for this job.
!config/git/ignore
!scripts/secret-scan.sh
