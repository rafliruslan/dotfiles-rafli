# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Neovim
config/nvim/lazy-lock.json
config/nvim/.luarc.json
config/nvim/after/queries/

# tmux plugins (managed by TPM)
config/tmux/plugins/*/

# Shell history and cache
.zsh_history
.bash_history
.zcompdump*

# Configs with sensitive/auth data
config/gh/
config/git/*
config/composer/

# TheFuck cache
config/thefuck/__pycache__/

# Raycast: all of it. config.json carries auth tokens and the filename
# gives no hint, which is how two of them stayed public for five months.
config/raycast/

# Backup files
*.backup
*.backup.*
*~

# Log files
*.log

# Temporary files
*.tmp
*.temp
.swp
.swo

# Local environment files
.env
.env.local

# SketchyBar compiled helpers (if any)
config/sketchybar/helpers/*
!config/sketchybar/helpers/.gitkeep

# Filenames that ARE credentials by convention. Deliberately narrow.
#
# This list used to be *password* *secret* *key* *token* *credential*, which
# got the job exactly backwards: it sailed past config/raycast/config.json,
# the one file that actually held tokens, while silently dropping three
# legitimate files - nvim's keymaps.lua, config/git/ignore, and the secret
# scanner itself. Contents decide whether something is a secret, so
# scripts/secret-scan.sh does that job on every commit.
*.pem
*.p12
*.pfx
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*
.env
.env.*
*credentials.json

# System-specific files that shouldn't be shared
*.local
*.private

# Lock files
*.lock

# Plan document
DOTFILES_PLAN.md

# Work identity - this repo is public
shell/.gitconfig-a1c

# Installed Claude skills are third-party and re-installable, like node_modules
claude/skills/

# Claude state: credentials, transcripts, caches. Only config is tracked.
claude/.credentials.json
claude/projects/
claude/sessions/
claude/history.jsonl

# config/git/ is excluded as a directory below, so the file inside needs an
# explicit re-include; git never descends into an ignored directory.
!config/git/ignore

# Editor and hand-rolled backups. *.backup was covered; *.bak was not,
# and seven sketchybar .bak files rode in on the first refresh.
*.bak
*.bak[0-9]
*.orig
*.rej
